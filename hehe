})
T5Left:AddBadge({
    Name  = "Mode",
    Text  = "Debug",
    Color = Color3.fromRGB(245, 168, 40),
    Style = "square",
})

local pingBadge = T5Left:AddBadge({
    Name  = "Ping",
    Text  = "-- ms",
    Color = Color3.fromRGB(155, 155, 170),
    Style = "pill",
})
-- Update ping badge live
task.spawn(function()
    while task.wait(1) do
        local ok, ping = pcall(function()
            return math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        if ok and pingBadge then pingBadge:SetText(tostring(ok and ping or 0) .. " ms") end
    end
end)

