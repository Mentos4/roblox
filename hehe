    }, {
        Create("UICorner", {CornerRadius = UDim.new(0, 4)})
    })
    local displayLabel = Create("TextLabel", {
        Size = UDim2.new(1, -30, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
