local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Mentos4/roblox/refs/heads/main/hehe?v=" .. tostring(os.time())))()

local Window = Library:CreateWindow({
    Name          = "Seisen Hub",
    SubTitle      = "Full UI Test",
    Version       = "v1.0.0",
    Icon          = "rbxassetid://126447337108612",
    ToggleKeybind = Enum.KeyCode.LeftAlt,
})

-- ================================================================
-- TAB 1 · Toggles & Buttons
-- ================================================================
Window:AddSidebarSection("Elements")
local Tab1 = Window:AddTab("Toggles", "toggle-right")

local T1Left  = Tab1:AddLeftSection("Toggles", "toggle-right")
local T1Right = Tab1:AddRightSection("Buttons", "mouse-pointer-click")

T1Left:AddToggle({
    Name     = "Toggle (Default Off)",
    Default  = false,
    Flag     = "T_ToggleOff",
    Tooltip  = "A basic off toggle.",
    Callback = function(v) print("[Toggle Off]", v) end,
})
T1Left:AddToggle({
    Name     = "Toggle (Default On)",
    Default  = true,
    Flag     = "T_ToggleOn",
    Callback = function(v) print("[Toggle On]", v) end,
})
T1Left:AddToggle({
    Name     = "Toggle + Keybind",
    Default  = false,
    Flag     = "T_ToggleKB",
    Keybind  = Enum.KeyCode.G,
    Tooltip  = "Press G to flip this toggle.",
    Callback = function(v) print("[Toggle KB]", v) end,
})

T1Left:AddDivider("Checkboxes")

T1Left:AddCheckbox({
    Name     = "Checkbox Off",
    Default  = false,
    Flag     = "T_CheckOff",
    Callback = function(v) print("[Checkbox Off]", v) end,
})
T1Left:AddCheckbox({
    Name     = "Checkbox On",
    Default  = true,
    Flag     = "T_CheckOn",
    Callback = function(v) print("[Checkbox On]", v) end,
})

T1Right:AddButton({
    Name     = "Normal Button",
    Tooltip  = "A safe action button.",
    Callback = function() print("[Button] Normal clicked") end,
})
T1Right:AddButton({
    Name     = "Risky Button",
    Risky    = true,
    Tooltip  = "A risky action button — no border.",
    Callback = function() print("[Button] Risky clicked") end,
})

T1Right:AddDivider("Dependency")

T1Right:AddToggle({
    Name     = "Show Dep Options",
    Default  = false,
    Flag     = "T_DepParent",
    Callback = function(v) print("[DepParent]", v) end,
})
local depBox = T1Right:AddDependencyBox({ DependsOn = "T_DepParent" })
if depBox and depBox.Frame then
    Library:CreateToggle(depBox.Frame, { Name = "Hidden Toggle A", Flag = "T_Dep1", Callback = function(v) print("[Dep1]", v) end })
    Library:CreateButton(depBox.Frame, { Name = "Hidden Button",   Callback = function() print("[DepBtn] clicked") end })
    Library:CreateSlider(depBox.Frame, { Name = "Hidden Slider", Min = 0, Max = 10, Default = 5, Flag = "T_DepSlider", Callback = function(v) print("[DepSlider]", v) end })
end

