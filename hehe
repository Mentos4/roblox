        Position         = UDim2.new(0, -3, 0, 10),
        BackgroundColor3 = typeColor,
        BorderSizePixel  = 0,
        BackgroundTransparency = 1,
        ZIndex           = 501,
        Parent           = card,
    }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

    -- Icon
    local icon = Create("ImageLabel", {
        Size                = UDim2.new(0, 18, 0, 18),
        BackgroundTransparency = 1,
        ImageColor3         = typeColor,
